# ---------------------------------------------------------------------------
# PostgreSQL + TimescaleDB connection settings
# Copy this file to `.env` and adjust as needed. NEVER commit the real .env.
# ---------------------------------------------------------------------------

POSTGRES_USER=iiot
POSTGRES_PASSWORD=iiot_password
POSTGRES_DB=iiot_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy / psycopg connection URL.
# Host should match POSTGRES_HOST above (localhost when running scripts from the
# host machine against the Dockerised database).
DATABASE_URL=postgresql+psycopg2://iiot:iiot_password@localhost:5432/iiot_platform

# ---------------------------------------------------------------------------
# Dataset / ingestion settings
# ---------------------------------------------------------------------------

# Path to the raw MetroPT-3 source. May point at a .zip or an extracted .csv.
# The inspection/ingestion scripts auto-locate the CSV inside data/raw/ if unset.
METROPT_SOURCE=data/raw/MetroPT3(AirCompressor).csv

# Rows read from the CSV per chunk during inspection/ingestion (memory control).
CHUNK_SIZE=100000

# Rows pushed to the DB per INSERT batch.
INSERT_BATCH_SIZE=10000

# --- Downsampling (Phase-1 dashboard) ---
# Aggregate the raw ~10s cadence into fixed time buckets before ingestion to keep
# the DB around 2-3M readings instead of ~22.7M. Analog signals use the bucket
# mean (trend-preserving); digital signals use the bucket majority (0/1 state).
# Run `python scripts/estimate_downsample.py` to see counts per interval.
#   90s  -> ~2.53M readings (88.9% reduction)   [default, in target band]
#   60s  -> ~3.79M | 120s -> ~1.90M | 300s -> ~0.76M
# Set DOWNSAMPLE_ENABLED=false to ingest the full raw resolution instead.
DOWNSAMPLE_ENABLED=true
DOWNSAMPLE_INTERVAL=90s
